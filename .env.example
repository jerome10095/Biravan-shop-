# Environment variables — example

# Neon / Postgres
DATABASE_URL=postgres://user:password@host:5432/dbname

# (Optional fallback while migrating) Supabase (client-side only)
VITE_SUPABASE_URL=https://your-supabase-url
VITE_SUPABASE_ANON_KEY=anon_key_here

# Cloudinary
VITE_CLOUDINARY_CLOUD_NAME=your_cloud
VITE_CLOUDINARY_UPLOAD_PRESET=unsigned_preset

# App config
ORDER_WHATSAPP_NUMBER=+250700000000

# Admin
ADMIN_JWT_SECRET=long_random_secret

# CI secrets to set in GitHub/Vercel/Netlify: DATABASE_URL, CLOUDINARY_*, ADMIN_JWT_SECRET, ORDER_WHATSAPP_NUMBER